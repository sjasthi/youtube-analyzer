YOUTUBE_API_KEY=your_api_key_here

# Temporary RAG development limit. The current question endpoint retrieves
# transcripts from only this many recent videos until transcript caching is merged.
RAG_TRANSCRIPT_VIDEO_LIMIT=3

# Optional: override the default local embedding model.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gemini generates the final RAG answer from FAISS transcript context.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Using "test_transcripts.json" to test without fetching transcript
RAG_TEST_MODE=true
YOUTUBE_API_KEY=your_api_key_here

# Number of recent videos considered for live RAG indexing/testing.
# Positive number = newest N videos. 0 = all available videos.
# Keep this low while testing youtube-transcript-api, then increase or set to 0 later.
RAG_TRANSCRIPT_VIDEO_LIMIT=3

# Pause only between NEW youtube-transcript-api requests. SQLite/Chroma cache
# hits do not wait. A small random jitter makes request timing less repetitive.
TRANSCRIPT_REQUEST_DELAY_SECONDS=8
TRANSCRIPT_REQUEST_JITTER_SECONDS=2

# Optional: override the local Sentence Transformer embedding model.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Increment this label if the transcript chunking strategy changes.
# Stored in Chroma so old/new chunks can be identified later.
RAG_CHUNKING_VERSION=v1
RAG_MIN_RELEVANCE_SCORE=-1.0

# Chroma persists transcript chunks and embeddings across FastAPI restarts.
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION_NAME=youtube_transcript_chunks

# Gemini generates the final RAG answer from Chroma-retrieved transcript context.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# true = use data/test_transcripts.json and never request live transcripts for RAG.
# false = use Chroma -> SQLite transcript cache -> YouTube fallback.
RAG_TEST_MODE=true
